From 0fbc192dc07798cc2690678efcb8743d6c8743f3 Mon Sep 17 00:00:00 2001
From: Matthias Gellrich <8877295+Marrrrtthias@users.noreply.github.com>
Date: Mon, 23 Nov 2026 23:04:27 +0000
Subject: [PATCH] iOS: post a notification with Stop while Find My Phone is
 ringing

Android shows "Finding your phone" with a Stop action while the
find-my-phone plugin rings; iOS only posts a notification on the
critical-alert path, which never runs without the critical-alerts
entitlement. Post a plain notification with the same title and body
while the alarm plays, and remove it when ringing stops.

As on Android, its Stop action and dismissing it stop ringing.
IOSDelegate routes the response through a new iOS-only libpebble3
function, handleFindMyPhoneNotificationResponse.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017MYjCJBY9vnEzMGPE17yA4
---
 .../kotlin/coredevices/coreapp/IOSDelegate.kt |  5 ++
 .../plugin/PhoneSoundPlayer.ios.kt            | 55 ++++++++++++++++++-
 2 files changed, 59 insertions(+), 1 deletion(-)

diff --git a/composeApp/src/iosMain/kotlin/coredevices/coreapp/IOSDelegate.kt b/composeApp/src/iosMain/kotlin/coredevices/coreapp/IOSDelegate.kt
index ab55c52..8227886 100644
--- a/composeApp/src/iosMain/kotlin/coredevices/coreapp/IOSDelegate.kt
+++ b/composeApp/src/iosMain/kotlin/coredevices/coreapp/IOSDelegate.kt
@@ -30,6 +30,7 @@ import coredevices.pebble.PebbleDeepLinkHandler
 import coredevices.util.isDebugBuild
 import io.rebble.libpebblecommon.connection.AppContext
 import io.rebble.libpebblecommon.connection.LibPebble
+import io.rebble.libpebblecommon.plugin.handleFindMyPhoneNotificationResponse
 import coredevices.pebble.permissions.handlePermissionNotificationResponse
 import coredevices.pebble.watchModule
 import coredevices.ring.reminders.ReminderCompleter
@@ -312,6 +313,10 @@ object IOSDelegate : KoinComponent {
         completionHandler: () -> Unit
     ) {
         logger.d { "userNotificationCenterDidReceive" }
+        if (handleFindMyPhoneNotificationResponse(response)) {
+            completionHandler()
+            return
+        }
         val userInfo = response.notification.request.content.userInfo ?: emptyMap<Any?, Any?>()
 
         val permissionAnswer = handlePermissionNotificationResponse(get(), response.actionIdentifier, userInfo) {
diff --git a/libpebble3/src/iosMain/kotlin/io/rebble/libpebblecommon/plugin/PhoneSoundPlayer.ios.kt b/libpebble3/src/iosMain/kotlin/io/rebble/libpebblecommon/plugin/PhoneSoundPlayer.ios.kt
index 2e63147..29ae38e 100644
--- a/libpebble3/src/iosMain/kotlin/io/rebble/libpebblecommon/plugin/PhoneSoundPlayer.ios.kt
+++ b/libpebble3/src/iosMain/kotlin/io/rebble/libpebblecommon/plugin/PhoneSoundPlayer.ios.kt
@@ -1,6 +1,7 @@
 package io.rebble.libpebblecommon.plugin
 
 import co.touchlab.kermit.Logger
+import io.rebble.libpebblecommon.di.LibPebbleKoinComponent
 import kotlinx.cinterop.ObjCObjectVar
 import kotlinx.cinterop.alloc
 import kotlinx.cinterop.memScoped
@@ -18,8 +19,13 @@ import platform.Foundation.NSBundle
 import platform.Foundation.NSError
 import platform.Foundation.NSURL
 import platform.UserNotifications.UNMutableNotificationContent
+import platform.UserNotifications.UNNotificationAction
+import platform.UserNotifications.UNNotificationCategory
+import platform.UserNotifications.UNNotificationCategoryOptionCustomDismissAction
+import platform.UserNotifications.UNNotificationDismissActionIdentifier
 import platform.UserNotifications.UNNotificationInterruptionLevel
 import platform.UserNotifications.UNNotificationRequest
+import platform.UserNotifications.UNNotificationResponse
 import platform.UserNotifications.UNNotificationSettingEnabled
 import platform.UserNotifications.UNNotificationSound
 import platform.UserNotifications.UNUserNotificationCenter
@@ -27,6 +33,9 @@ import platform.UserNotifications.UNUserNotificationCenter
 // System alarm sound, used unless the app bundles its own find_my_phone.caf.
 private const val SYSTEM_ALARM_SOUND = "/System/Library/Audio/UISounds/alarm.caf"
 private const val CRITICAL_NOTIFICATION_ID = "find_my_phone_critical"
+private const val CATEGORY_ID = "find_my_phone"
+private const val NOTIFICATION_ID = "find_my_phone_ringing"
+private const val ACTION_STOP_RINGING = "find_my_phone_stop"
 
 // Below this system output volume the AVAudioPlayer is too quiet to find the phone by, so we ask
 // for a critical alert instead. Heuristic threshold, tune against real devices.
@@ -126,6 +135,7 @@ internal actual class PhoneSoundPlayer {
                 play()
             }
             _isRinging.value = true
+            showStopNotification()
         } catch (e: Exception) {
             logger.w(e) { "Failed to start ringing" }
             cleanUp()
@@ -137,6 +147,35 @@ internal actual class PhoneSoundPlayer {
         cleanUp()
     }
 
+    // Silent: the alarm is already playing.
+    private fun showStopNotification() {
+        val center = UNUserNotificationCenter.currentNotificationCenter()
+        // The category must be registered before the notification is posted, or it shows no Stop.
+        center.getNotificationCategoriesWithCompletionHandler { categories ->
+            val others = (categories as Set<*>? ?: emptySet<Any>())
+                .filterNot { (it as? UNNotificationCategory)?.identifier == CATEGORY_ID }
+                .toSet()
+            val category = UNNotificationCategory.categoryWithIdentifier(
+                CATEGORY_ID,
+                listOf(UNNotificationAction.actionWithIdentifier(ACTION_STOP_RINGING, "Stop", 0u)),
+                emptyList<String>(),
+                UNNotificationCategoryOptionCustomDismissAction,
+            )
+            center.setNotificationCategories(others + category)
+            if (!_isRinging.value) return@getNotificationCategoriesWithCompletionHandler
+
+            val content = UNMutableNotificationContent().apply {
+                setTitle("Finding your phone")
+                setBody("Ringing from your watch")
+                setCategoryIdentifier(CATEGORY_ID)
+            }
+            val request = UNNotificationRequest.requestWithIdentifier(NOTIFICATION_ID, content, null)
+            center.addNotificationRequest(request) { error ->
+                if (error != null) logger.w { "Failed to post ringing notification: $error" }
+            }
+        }
+    }
+
     private fun cleanUp() {
         player?.stop()
         player = null
@@ -145,7 +184,21 @@ internal actual class PhoneSoundPlayer {
             AVAudioSession.sharedInstance().setActive(false, error = err.ptr)
         }
         UNUserNotificationCenter.currentNotificationCenter()
-            .removeDeliveredNotificationsWithIdentifiers(listOf(CRITICAL_NOTIFICATION_ID))
+            .removeDeliveredNotificationsWithIdentifiers(listOf(CRITICAL_NOTIFICATION_ID, NOTIFICATION_ID))
         _isRinging.value = false
     }
 }
+
+/**
+ * Stops ringing when the find-my-phone notification's Stop is tapped or the notification is
+ * dismissed, as on Android. Returns false if [response] is for another notification.
+ */
+public fun handleFindMyPhoneNotificationResponse(response: UNNotificationResponse): Boolean {
+    if (response.notification.request.identifier != NOTIFICATION_ID) return false
+    if (response.actionIdentifier == ACTION_STOP_RINGING ||
+        response.actionIdentifier == UNNotificationDismissActionIdentifier
+    ) {
+        object : LibPebbleKoinComponent {}.getKoin().get<PhoneSoundPlayer>().stopRinging()
+    }
+    return true
+}
